#!/bin/sh
cd "${0%/*}" || exit                            # Run from this directory
targetType=libso                                # Default target type
. "${WM_PROJECT_DIR:?}"/wmake/scripts/AllwmakeParseArguments
#------------------------------------------------------------------------------
# Install locations are controlled by FOAM_MODULE_PREFIX (or -prefix=...).
# Standalone build: user locations ($FOAM_USER_APPBIN, $FOAM_USER_LIBBIN).
# Built as an OpenFOAM plugin: project locations ($FOAM_APPBIN, $FOAM_LIBBIN).

for lib in QGD TwoPhaseQGD CombustionQGD ChemistryQGD
do
    wmake $targetType lib/"$lib"
done

for solver in \
    QGDFoam rhoQGDFoam QHDFoam mulesQHDFoam zQGDFoam interQHDFoam \
    particlesQGDFoam particlesQHDFoam QHDDyMFoam SRFQHDFoam \
    reactingLagrangianQGDFoam rhoReactingLagrangianQGDFoam \
    reactingQGDFoam scalarTransportQHDFoam
do
    wmake app/"$solver"
done

wmake app/utils/selectBadCells

#------------------------------------------------------------------------------
